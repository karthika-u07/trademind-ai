APP_NAME=trademind-ai
ENVIRONMENT=development
LOG_LEVEL=INFO

TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
RISK_PER_TRADE=0.01
MAX_DAILY_DRAWDOWN=0.05
MAX_DAILY_PROFIT=0.10
MAX_OPEN_POSITIONS=3
MAX_SPREAD_POINTS=5.0
MAX_SLIPPAGE_POINTS=3.0

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trademind
