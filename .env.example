APP_NAME=trademind-ai
ENVIRONMENT=development
LOG_LEVEL=INFO

TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
RISK_PER_TRADE=0.01
MAX_DAILY_DRAWDOWN=0.05
MAX_DAILY_PROFIT=0.10
MAX_OPEN_POSITIONS=3
MAX_SPREAD_POINTS=5.0
MAX_SLIPPAGE_POINTS=3.0
CORRELATION_PROTECTION_ENABLED=false
CORRELATION_TIMEFRAME=H1
CORRELATION_LOOKBACK=60
CORRELATION_MIN_SAMPLES=30
CORRELATION_THRESHOLD=0.80
MAX_CORRELATED_POSITIONS=1
MAX_CORRELATED_EXPOSURE=100000.0
CORRELATION_MAX_DATA_AGE_SECONDS=7200

POSITION_TRAILING_STOP_ENABLED=false
POSITION_TRAILING_TRIGGER_ATR_MULTIPLIER=1.5
POSITION_TRAILING_DISTANCE_ATR_MULTIPLIER=1.0
POSITION_BREAK_EVEN_ENABLED=false
POSITION_BREAK_EVEN_TRIGGER_ATR_MULTIPLIER=1.0
POSITION_BREAK_EVEN_OFFSET_POINTS=0

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

NEWS_CALENDAR_FILE=C:\Users\karth\AppData\Roaming\MetaQuotes\Terminal\Common\Files\trademind_calendar.csv
NEWS_CALENDAR_REFRESH_SECONDS=30
NEWS_BLOCK_BEFORE_MINUTES=10
NEWS_BLOCK_AFTER_MINUTES=10

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trademind
